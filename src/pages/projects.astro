---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import { projectCategories } from '../data/site';
import { getCollection } from 'astro:content';
const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Projects">
  <div class="container">
    <PageHeader title="Projects" />
    {projectCategories.map((c) => (
      <section class="listing-section" id={c.id}>
        <h2>{c.title}</h2>
        {entries.filter((e) => e.data.category === c.id).length ? (
          entries
            .filter((e) => e.data.category === c.id)
            .map((entry) => (
              <article class="record">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
                <div class="record-links">
                  {entry.data.links.map((link) => (
                    <a href={link.url}>{link.label} ↗</a>
                  ))}
                </div>
              </article>
            ))
        ) : (
          <EmptyState text="Details coming soon." />
        )}
      </section>
    ))}
  </div>
</Layout>
