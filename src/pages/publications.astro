---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import { publicationCategories } from '../data/site';
import { getCollection } from 'astro:content';
const entries = (
  await getCollection('publications', ({ data }) => !data.draft)
).sort((a, b) => b.data.year - a.data.year);
---

<Layout title="Publications">
  <div class="container">
    <PageHeader title="Publications" />
    {publicationCategories.map((c) => (
      <section class="listing-section" id={c.id}>
        <h2>{c.title}</h2>
        {entries.filter((e) => e.data.category === c.id).length ? (
          entries
            .filter((e) => e.data.category === c.id)
            .map((entry) => (
              <article class="record">
                <p class="small-label">
                  {entry.data.year} · {entry.data.venue}
                </p>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.authors}</p>
                <div class="record-links">
                  {entry.data.links.map((link) => (
                    <a href={link.url}>{link.label} ↗</a>
                  ))}
                </div>
              </article>
            ))
        ) : (
          <EmptyState text="Records coming soon." />
        )}
      </section>
    ))}
  </div>
</Layout>
